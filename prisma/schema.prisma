generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ATTENDANT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  ORDER
  SYSTEM
  UNSUPPORTED
}

enum MessageStatus {
  PENDING
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaStatus {
  PENDING
  AVAILABLE
  FAILED
}

enum MessageOperationalState {
  READY
  UPLOAD_IN_FLIGHT
  SEND_IN_FLIGHT
  OUTCOME_UNKNOWN
  SENT
  REJECTED
  LOCAL_FAILURE
}

enum WebhookStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum ConversationAuditAction {
  READ
  MARKED_UNREAD
}

model User {
  id                        String                   @id @default(uuid()) @db.Uuid
  name                      String
  email                     String                   @unique
  passwordHash              String                   @map("password_hash")
  role                      UserRole
  active                    Boolean                  @default(true)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                  Session[]
  assignedConversations     Conversation[]           @relation("ResponsibleUser")
  sentMessages              Message[]                @relation("SentByUser")
  conversationReads         ConversationRead[]
  manualUnreadConversations Conversation[]           @relation("ManualUnreadByUser")
  conversationAuditEvents   ConversationAuditEvent[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Contact {
  id                String                 @id @default(uuid()) @db.Uuid
  whatsappId        String?                @unique @map("whatsapp_id")
  whatsappUserId    String?                @unique @map("whatsapp_user_id")
  phone             String?                @unique
  name              String
  preferredName     String?                @map("preferred_name")
  profilePictureUrl String?                @map("profile_picture_url")
  contactTypeId     String?                @map("contact_type_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation      Conversation?
  contactType       ContactType?           @relation(fields: [contactTypeId], references: [id], onDelete: SetNull)
  tagAssignments    ContactTagAssignment[]

  @@map("contacts")
}

model ContactType {
  id             String    @id @default(uuid()) @db.Uuid
  displayName    String    @map("display_name")
  normalizedName String    @unique @map("normalized_name")
  /// Stored as uppercase #RRGGBB; enforced by the database migration.
  color          String
  position       Int
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  contacts       Contact[]

  @@index([active, position])
  @@map("contact_types")
}

model ContactTagDefinition {
  id             String                 @id @default(uuid()) @db.Uuid
  displayName    String                 @map("display_name")
  normalizedName String                 @unique @map("normalized_name")
  /// Stored as uppercase #RRGGBB; enforced by the database migration.
  color          String
  position       Int
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments    ContactTagAssignment[]

  @@index([active, position])
  @@map("contact_tag_definitions")
}

model ContactTagAssignment {
  contactId String               @map("contact_id") @db.Uuid
  tagId     String               @map("tag_id") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  contact   Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       ContactTagDefinition @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([contactId, tagId])
  @@index([tagId, contactId])
  @@map("contact_tag_assignments")
}

model Conversation {
  id                    String                   @id @default(uuid()) @db.Uuid
  contactId             String                   @unique @map("contact_id") @db.Uuid
  responsibleUserId     String?                  @map("responsible_user_id") @db.Uuid
  lastMessageAt         DateTime                 @map("last_message_at") @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  teamLastReadMessageId String?                  @map("team_last_read_message_id") @db.Uuid
  teamLastReadAt        DateTime?                @map("team_last_read_at") @db.Timestamptz(3)
  manualUnreadAt        DateTime?                @map("manual_unread_at") @db.Timestamptz(3)
  manualUnreadByUserId  String?                  @map("manual_unread_by_user_id") @db.Uuid
  awaitingResponseSince DateTime?                @map("awaiting_response_since") @db.Timestamptz(3)
  contact               Contact                  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  responsibleUser       User?                    @relation("ResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  teamLastReadMessage   Message?                 @relation("TeamLastReadMessage", fields: [teamLastReadMessageId], references: [id], onDelete: SetNull)
  manualUnreadByUser    User?                    @relation("ManualUnreadByUser", fields: [manualUnreadByUserId], references: [id], onDelete: SetNull)
  messages              Message[]
  reads                 ConversationRead[]
  auditEvents           ConversationAuditEvent[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id                  String                  @id @default(uuid()) @db.Uuid
  conversationId      String                  @map("conversation_id") @db.Uuid
  whatsappMessageId   String?                 @unique @map("whatsapp_message_id")
  clientRequestId     String?                 @unique @map("client_request_id") @db.Uuid
  direction           MessageDirection
  type                MessageType
  body                String?
  content             Json?
  searchText          String                  @default("") @map("search_text")
  replyToMessageId    String?                 @map("reply_to_message_id") @db.Uuid
  replyToWhatsappMessageId String?             @map("reply_to_whatsapp_message_id")
  mediaObjectId       String?                 @unique @map("media_object_id") @db.Uuid
  sentByUserId        String?                 @map("sent_by_user_id") @db.Uuid
  status              MessageStatus
  failureReason       String?                 @map("failure_reason")
  operationalState    MessageOperationalState @default(READY) @map("operational_state")
  providerAttemptedAt DateTime?               @map("provider_attempted_at") @db.Timestamptz(3)
  deliveryLeaseId     String?                 @map("delivery_lease_id") @db.Uuid
  deliveryLeaseUntil  DateTime?               @map("delivery_lease_until") @db.Timestamptz(3)
  externalTimestamp   DateTime                @map("external_timestamp") @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation        Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaObject         MediaObject?            @relation(fields: [mediaObjectId], references: [id], onDelete: SetNull)
  sentByUser          User?                   @relation("SentByUser", fields: [sentByUserId], references: [id], onDelete: Restrict)
  replyToMessage      Message?                @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies             Message[]               @relation("MessageReplies")
  lastReadFor         ConversationRead[]      @relation("LastReadMessage")
  teamLastReadFor     Conversation[]          @relation("TeamLastReadMessage")

  @@index([conversationId, externalTimestamp])
  @@index([conversationId, direction, externalTimestamp, id], map: "messages_response_state_idx")
  @@index([status, operationalState, deliveryLeaseUntil], map: "messages_delivery_claim_idx")
  @@index([replyToMessageId], map: "messages_reply_to_message_id_idx")
  @@index([conversationId, replyToWhatsappMessageId], map: "messages_reply_external_lookup_idx")
  @@map("messages")
}

model MediaObject {
  id                    String      @id @default(uuid()) @db.Uuid
  storageProvider       String      @map("storage_provider")
  storageKey            String?     @map("storage_key")
  originalFilename      String      @map("original_filename")
  mimeType              String      @map("mime_type")
  sizeBytes             BigInt      @map("size_bytes")
  sha256                String?
  metaMediaId           String?     @map("meta_media_id")
  status                MediaStatus
  failureReason         String?     @map("failure_reason")
  terminalTransitionId  String?     @map("terminal_transition_id") @db.Uuid
  downloadLeaseId       String?     @map("download_lease_id") @db.Uuid
  downloadLeaseUntil    DateTime?   @map("download_lease_until") @db.Timestamptz(3)
  downloadNextAttemptAt DateTime?   @map("download_next_attempt_at") @db.Timestamptz(3)
  downloadAttempts      Int         @default(0) @map("download_attempts")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  message               Message?

  @@index([status, downloadNextAttemptAt, downloadLeaseUntil], map: "media_objects_download_claim_idx")
  @@map("media_objects")
}

model ConversationRead {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  lastReadMessageId String?      @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime     @map("last_read_at") @db.Timestamptz(3)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadMessage   Message?     @relation("LastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@map("conversation_reads")
}

model ConversationAuditEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  conversationId String                  @map("conversation_id") @db.Uuid
  actorUserId    String                  @map("actor_user_id") @db.Uuid
  action         ConversationAuditAction
  messageId      String?                 @map("message_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorUser      User                    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@map("conversation_audit_events")
}

model WebhookEvent {
  id               String        @id @default(uuid()) @db.Uuid
  deduplicationKey String        @unique @map("deduplication_key")
  eventType        String        @map("event_type")
  status           WebhookStatus
  errorSummary     String?       @map("error_summary")
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("webhook_events")
}

model QuickReply {
  id        String   @id @default(uuid()) @db.Uuid
  shortcut  String   @unique
  message   String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active, position, shortcut])
  @@map("quick_replies")
}
