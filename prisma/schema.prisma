generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ATTENDANT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  UNSUPPORTED
}

enum MessageStatus {
  PENDING
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaStatus {
  PENDING
  AVAILABLE
  FAILED
}

enum MessageOperationalState {
  READY
  UPLOAD_IN_FLIGHT
  SEND_IN_FLIGHT
  OUTCOME_UNKNOWN
  SENT
  REJECTED
  LOCAL_FAILURE
}

enum WebhookStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String
  email                 String             @unique
  passwordHash          String             @map("password_hash")
  role                  UserRole
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  assignedConversations Conversation[]     @relation("ResponsibleUser")
  sentMessages          Message[]          @relation("SentByUser")
  conversationReads     ConversationRead[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Contact {
  id                String        @id @default(uuid()) @db.Uuid
  whatsappId        String        @unique @map("whatsapp_id")
  phone             String        @unique
  name              String
  profilePictureUrl String?       @map("profile_picture_url")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation      Conversation?

  @@map("contacts")
}

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  contactId         String             @unique @map("contact_id") @db.Uuid
  responsibleUserId String?            @map("responsible_user_id") @db.Uuid
  lastMessageAt     DateTime           @map("last_message_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  responsibleUser   User?              @relation("ResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  messages          Message[]
  reads             ConversationRead[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id                  String              @id @default(uuid()) @db.Uuid
  conversationId      String              @map("conversation_id") @db.Uuid
  whatsappMessageId   String?             @unique @map("whatsapp_message_id")
  clientRequestId     String?             @unique @map("client_request_id") @db.Uuid
  direction           MessageDirection
  type                MessageType
  body                String?
  mediaObjectId       String?             @unique @map("media_object_id") @db.Uuid
  sentByUserId        String?             @map("sent_by_user_id") @db.Uuid
  status              MessageStatus
  failureReason       String?             @map("failure_reason")
  operationalState    MessageOperationalState @default(READY) @map("operational_state")
  providerAttemptedAt DateTime?           @map("provider_attempted_at") @db.Timestamptz(3)
  deliveryLeaseId     String?             @map("delivery_lease_id") @db.Uuid
  deliveryLeaseUntil  DateTime?           @map("delivery_lease_until") @db.Timestamptz(3)
  externalTimestamp   DateTime            @map("external_timestamp") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation        Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaObject         MediaObject?        @relation(fields: [mediaObjectId], references: [id], onDelete: SetNull)
  sentByUser          User?               @relation("SentByUser", fields: [sentByUserId], references: [id], onDelete: Restrict)
  lastReadFor         ConversationRead[]   @relation("LastReadMessage")

  @@index([conversationId, externalTimestamp])
  @@index([status, operationalState, deliveryLeaseUntil], map: "messages_delivery_claim_idx")
  @@map("messages")
}

model MediaObject {
  id               String      @id @default(uuid()) @db.Uuid
  storageProvider  String      @map("storage_provider")
  storageKey       String?     @map("storage_key")
  originalFilename String      @map("original_filename")
  mimeType         String      @map("mime_type")
  sizeBytes        BigInt      @map("size_bytes")
  sha256           String?
  metaMediaId      String?     @map("meta_media_id")
  status           MediaStatus
  failureReason    String?     @map("failure_reason")
  downloadLeaseId  String?     @map("download_lease_id") @db.Uuid
  downloadLeaseUntil DateTime? @map("download_lease_until") @db.Timestamptz(3)
  downloadNextAttemptAt DateTime? @map("download_next_attempt_at") @db.Timestamptz(3)
  downloadAttempts Int         @default(0) @map("download_attempts")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  message          Message?

  @@index([status, downloadNextAttemptAt, downloadLeaseUntil], map: "media_objects_download_claim_idx")
  @@map("media_objects")
}

model ConversationRead {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  lastReadMessageId String?      @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime     @map("last_read_at") @db.Timestamptz(3)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadMessage   Message?      @relation("LastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@map("conversation_reads")
}

model WebhookEvent {
  id               String        @id @default(uuid()) @db.Uuid
  deduplicationKey String        @unique @map("deduplication_key")
  eventType        String        @map("event_type")
  status           WebhookStatus
  errorSummary     String?       @map("error_summary")
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("webhook_events")
}
